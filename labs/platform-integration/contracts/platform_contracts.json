            "fixtures/platform_channel/android/DeviceBridgePlugin.kt",
            "fixtures/platform_channel/ios/DeviceBridgePlugin.swift"
          ]
        }
      ],
      "runtime_evidence": {
        "status": "not_collected",
        "requires": [
          "Flutter 3.47.1 engine",
          "Android SDKまたはfull Xcode",
          "対象Simulatorまたは実機"
        ]
      }
    },
