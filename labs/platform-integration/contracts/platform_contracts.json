      "id": "platform-channel.method-contract",
      "scope": "source_contract",
      "checks": [
        {
          "file": "fixtures/platform_channel/lib/device_bridge.dart",
          "contains": [
            "static const MethodChannel _channel = MethodChannel(",
            "'dev.flutter.reference_atlas/device'",
            "invokeMethod<String>('getPlatformVersion')"
          ],
          "not_contains": ["dart:ffi", "dart:js_interop"]
        },
        {
          "file": "fixtures/platform_channel/android/DeviceBridgePlugin.kt",
          "contains": [
            "MethodChannel(binding.binaryMessenger, \"dev.flutter.reference_atlas/device\")",
            "call.method == \"getPlatformVersion\"",
            "result.success(android.os.Build.VERSION.RELEASE)"
          ]
        },
        {
          "file": "fixtures/platform_channel/ios/DeviceBridgePlugin.swift",
          "contains": [
            "let channel = FlutterMethodChannel(",
            "name: \"dev.flutter.reference_atlas/device\"",
            "call.method == \"getPlatformVersion\"",
            "result(UIDevice.current.systemVersion)"
          ]
        }
      ],
      "shared_tokens": [
        {
          "name": "channel-name",
          "value": "dev.flutter.reference_atlas/device",
          "files": [
            "fixtures/platform_channel/lib/device_bridge.dart",
