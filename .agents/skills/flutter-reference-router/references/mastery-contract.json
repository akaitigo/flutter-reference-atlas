  "schema_version": 1,
  "source": "mastery.yaml",
  "surfaces": [
    {
      "applicability": "required",
      "id": "orientation-scope",
      "rationale": "Flutterで扱う公開アプリ開発Surfaceと対象外を明示し、誤った入口や完全性の誤認を防ぐために必要である。",
      "required_deliverables": [
        "concept",
        "decision"
      ],
      "target_sets": [
        "baseline",
        "language-platform"
      ],
      "title": "定義・目的・境界"
    },
    {
      "applicability": "required",
      "id": "foundations-mechanics",
      "rationale": "Widget lifecycle、状態、非同期処理、Platform境界の挙動を表面的なAPI利用ではなく説明するために必要である。",
      "required_deliverables": [
        "concept",
        "lab"
      ],
      "target_sets": [
        "language-platform",
        "execution"
      ],
      "title": "原理・内部機構・Invariant"
    },
    {
      "applicability": "required",
      "id": "architecture-design",
      "rationale": "UI、状態、Repository、Platform依存を試験可能で保守可能な責任境界へ分解するために必要である。",
      "required_deliverables": [
        "decision",
        "reference-implementation"
      ],
      "target_sets": [
        "product",
        "language-platform"
      ],
      "title": "Architecture・設計"
    },
    {
      "applicability": "required",
      "id": "implementation-construction",
      "rationale": "Adaptive UIと状態遷移を公開Surfaceだけで構築し、実行可能な参照実装とLabへ結び付けるために必要である。",
      "required_deliverables": [
        "reference-implementation",
        "lab"
      ],
      "target_sets": [
        "product",
        "execution"
      ],
      "title": "実装・構築"
    },
    {
      "applicability": "required",
      "id": "testing-verification",
      "rationale": "正常、境界、拒否、障害、復旧の主張を固定HarnessとArtifactで反復検証するために必要である。",
      "required_deliverables": [
        "test",
        "evidence"
      ],
      "target_sets": [
        "product",
        "execution",
        "quality"
      ],
      "title": "試験・検証"
    },
    {
      "applicability": "required",
      "id": "failure-recovery",
      "rationale": "非同期競合、Lifecycle、永続化、Platform統合の失敗を隔離して再現し、安全に復旧するために必要である。",
      "required_deliverables": [
        "failure-catalog",
        "runbook",
        "evidence"
      ],
      "target_sets": [
        "product",
        "execution",
        "quality"
      ],
      "title": "失敗・診断・回復"
    },
    {
      "applicability": "required",
      "id": "operations-observability",
      "rationale": "利用者環境で発生する状態不整合、性能劣化、障害を観測し、証拠から診断するために必要である。",
      "required_deliverables": [
        "runbook",
        "evidence"
      ],
      "target_sets": [
        "product",
        "quality"
      ],
      "title": "運用・Observability"
    },
    {
      "applicability": "required",
      "id": "security-privacy-safety",
      "rationale": "入力、秘密、端末権限、保存Data、外部連携の境界を安全に扱い、公開前に検証するために必要である。",
      "required_deliverables": [
        "security-review",
        "test"
      ],
      "target_sets": [
        "product",
        "quality"
      ],
      "title": "Security・Privacy・Safety"
    },
    {
      "applicability": "required",
      "id": "performance-capacity-cost",
      "rationale": "Frame、Memory、起動、通信、Artifact容量の予算と劣化を測り、設計判断へ戻すために必要である。",
      "required_deliverables": [
        "benchmark",
        "evidence"
      ],
      "target_sets": [
        "product",
        "quality"
      ],
      "title": "性能・容量・Cost"
    },
    {
      "applicability": "required",
      "id": "compatibility-integration",
      "rationale": "FlutterとDartのVersion、公式6 Platform、Host toolchainの差を区別して統合判断するために必要である。",
      "required_deliverables": [
        "test",
        "evidence"
      ],
      "target_sets": [
        "baseline",
        "language-platform",
        "execution"
      ],
      "title": "互換性・Integration"
    },
    {
      "applicability": "required",
      "id": "migration-evolution-deprecation",
      "rationale": "SDKや公開APIの変更時に利用者挙動と証拠の有効範囲を壊さず移行するために必要である。",
      "required_deliverables": [
        "migration-guide",
        "test"
      ],
      "target_sets": [
        "baseline",
        "language-platform",
        "quality"
      ],
      "title": "移行・進化・廃止"
    },
    {
      "applicability": "required",
      "id": "decision-comparison",
      "rationale": "状態管理、実行Profile、Platform対応の条件、利点、失敗、Costを同じ基準で比較するために必要である。",
      "required_deliverables": [
        "decision",
        "benchmark"
      ],
      "target_sets": [
        "product",
        "language-platform",
        "quality"
      ],
      "title": "選択・比較・Trade-off"
    },
    {
      "applicability": "required",
      "id": "provenance-rights",
      "rationale": "一次資料、SDK由来物、Container、依存物、独自実装の来歴と再配布条件を追跡するために必要である。",
      "required_deliverables": [
        "provenance-record",
        "evidence"
      ],
      "target_sets": [
        "baseline",
        "quality"
      ],
      "title": "出典・来歴・権利"
    },
    {
      "applicability": "required",
      "id": "agent-skill",
      "rationale": "AgentがCoverage状態と一次資料を守り、適切な実装、Lab、Evidence、未達報告へ到達するために必要である。",
      "required_deliverables": [
        "skill-reference",
        "skill-eval"
      ],
      "target_sets": [
        "skill"
      ],
      "title": "Agent Skill・評価"
    }
  ]
}
